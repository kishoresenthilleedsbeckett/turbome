import sys

def process_file(file_name):
    """
    Process the input file to extract the Grand Prix location and lap times for each driver.

    Args:
    file_name (str): The name of the file containing lap times.

    Returns:
    tuple: The location of the Grand Prix and a dictionary of driver lap times.
    """
    try:
        with open(file_name, 'r') as file:
            # Read all lines from the file
            lines = file.readlines()

            if not lines:
                raise ValueError("The file is empty.")

            # The first line of the file is the location of the Grand Prix
            location = lines[0].strip()

            # Dictionary to store lap times for each driver
            driver_times = {}

            # Process each driver's lap time entry
            for line in lines[1:]:
                if len(line) < 4:
                    continue  # Skip malformed lines
                # First three characters are the driver's code
                driver_code = line[:3]
                try:
                    # The rest is the lap time
                    lap_time = float(line[3:].strip())
                except ValueError:
                    print(f"Warning: Invalid lap time '{line[3:].strip()}' for driver {driver_code}. Skipping entry.")
                    continue

                # Append the lap time to the driver's list of times
                if driver_code in driver_times:
                    driver_times[driver_code].append(lap_time)
                else:
                    # Create a new entry for this driver
                    driver_times[driver_code] = [lap_time]

            return location, driver_times

    except FileNotFoundError:
        print(f"Error: The file '{file_name}' was not found.")
        sys.exit(1)
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

def calculate_stats(driver_times):
    """
    Calculate statistics from the lap times for each driver.

    Args:
    driver_times (dict): A dictionary containing driver lap times.

    Returns:
    tuple: The fastest driver, fastest lap time, overall average lap time, and driver statistics.
    """
    fastest_driver = None
    fastest_time = float('inf')  # Initialize to infinity for comparison

    total_time = 0  # Cumulative total lap time for all drivers
    total_laps = 0  # Cumulative total number of laps for all drivers
    driver_stats = {}

    # Process each driver's lap times to calculate statistics
    for driver, times in driver_times.items():
        if not times:
            continue  # Skip drivers with no lap times
        best_time = min(times)  # Fastest time for this driver
        average_time = sum(times) / len(times)  # Average time for this driver

        # Update the fastest driver and time
        if best_time < fastest_time:
            fastest_time = best_time
            fastest_driver = driver

        # Update overall time and lap count for average calculation
        total_time += sum(times)
        total_laps += len(times)

        # Store the stats for each driver
        driver_stats[driver] = {
            'best_time': best_time,
            'average_time': average_time
        }

    # Calculate the overall average time for all drivers
    overall_average_time = total_time / total_laps if total_laps > 0 else 0

    return fastest_driver, fastest_time, overall_average_time, driver_stats

def display_results(location, fastest_driver, fastest_time, overall_average_time, driver_stats):
    """
    Display the results of the Grand Prix, including fastest lap times and driver statistics.

    Args:
    location (str): The location of the Grand Prix.
    fastest_driver (str): The code of the driver with the fastest lap time.
    fastest_time (float): The fastest lap time.
    overall_average_time (float): The overall average lap time for all drivers.
    driver_stats (dict): A dictionary containing statistics for each driver.
    """
    print(f"Grand Prix: {location}\n")

    # Print the fastest lap time and the driver
    if fastest_driver and fastest_time < float('inf'):
        print(f"Fastest Lap Time: {fastest_driver} - {fastest_time:.3f} seconds\n")
    else:
        print("No valid lap times found for the fastest lap.\n")

    # Print the overall average time
    print(f"Overall Average Time: {overall_average_time:.3f} seconds\n")

    # Display stats for each driver
    print("Driver Stats:")
    for driver, stats in driver_stats.items():
        print(f"{driver}:")
        print(f"  Fastest Lap: {stats['best_time']:.3f} seconds")
        print(f"  Average Lap Time: {stats['average_time']:.3f} seconds\n")

    # Display the fastest lap times in descending order
    print("Fastest Laps (Descending Order):")
    sorted_drivers = sorted(driver_stats.items(), key=lambda x: x[1]['best_time'])
    for driver, stats in sorted_drivers:
        print(f"{driver} - {stats['best_time']:.3f} seconds")

def main():
    """
    Main function to handle the program execution.
    """
    if len(sys.argv) != 2:
        print("Usage: python script.py <file_name>")
        sys.exit(1)

    file_name = sys.argv[1]

    # Process the file and calculate stats
    location, driver_times = process_file(file_name)
    fastest_driver, fastest_time, overall_average_time, driver_stats = calculate_stats(driver_times)

    # Display the results
    display_results(location, fastest_driver, fastest_time, overall_average_time, driver_stats)

if __name__ == "__main__":
    main()
